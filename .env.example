# ESPN private-league cookies. Pull from DevTools > Application > Cookies > fantasy.espn.com
# espn_s2 is 250+ chars; swid is ~38 chars INCLUDING the curly braces.
# This file is committed. .env is NOT. Never paste real values into a chat.
ESPN_S2=
ESPN_SWID=
ESPN_LEAGUE_ID=
# The date of the college season's first game. A date, not a week number: a pinned week is
# right for seven days and silently wrong for the rest of the season, while a date stated
# once in August stays true through January.
CFB_WEEK_ONE=

CFBD_API_KEY=
ODDS_API_KEY=

# The survivor pool host (hub.fetch.pool). POOL_URL is the pool resource's JSON URL and
# POOL_SESSION its session cookie's value, copied from DevTools; POOL_COOKIE_NAME is the name
# the host gives that cookie (default: session). The value goes to the host and nowhere else.
# POOL_ENTRY_ID is our own entry's id on the host, so it lands at index 0 and every other
# member is indexed and never named.
POOL_URL=
POOL_SESSION=
POOL_COOKIE_NAME=
POOL_ENTRY_ID=
